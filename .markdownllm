framework: MarkdownLLM
version: 3.3.0
role: canonical-version-sentinel
foundational_specs:
  - thing.md
  - read.thing.md
  - write.thing.md
  - validate.thing.md
  - interface.md
  - git-workflow.md
  - framework-discovery.md
  - domain-refresh.md
