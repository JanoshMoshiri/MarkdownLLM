{
  "id": "markdownllm",
  "name": "MarkdownLLM",
  "description": "Binds designated OpenClaw agents to MarkdownLLM domain lifecycle context",
  "activation": {
    "onStartup": true,
    "onCommands": [
      "domain"
    ],
    "onCapabilities": [
      "hook"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "domains"
    ],
    "properties": {
      "domains": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agentId"
          ],
          "properties": {
            "agentId": {
              "type": "string",
              "minLength": 1
            },
            "topicName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      },
      "command": {
        "type": "string",
        "minLength": 1,
        "default": "mdllm"
      },
      "commandArgs": {
        "type": "array",
        "default": [],
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 120000,
        "default": 115000
      }
    }
  }
}
