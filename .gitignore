# .claude/ is now tracked: settings.json (the Claude Code / VS Code Copilot hook
# adapter) and commands/ ship with the repo. Per-user local settings stay out:
.claude/settings.local.json
domains/
domain/
adapters/logs/
# Run workspaces are bulky, ephemeral, and are themselves git repos (cannot
# be partially tracked). The scored evidence is the basis of the framework's
# empirical claims — committed state is the only real state — so the runner
# mirrors each result.json into evals/results/, which IS tracked
# (review 2026-06-12, finding 4).
evals/runs/
__pycache__/
.pytest_cache/
.venv/

# WORKLOG is an on-demand view of the commit stream (mdllm worklog), not a committed artifact
WORKLOG.md

# Local disclosure boundary (mdllm boundary) — the vocabulary never enters any
# repo; the check itself errors if this file is ever tracked
.boundary-terms

# Built harness bundles (mdllm bundle) are PRIVATE: the rendered config
# names the operator's repositories. Templates are tracked; builds never are.
.bundle-build/

# Explorer's private synthetic/runtime evidence never enters the release surface.
explorer/.test-tmp/
