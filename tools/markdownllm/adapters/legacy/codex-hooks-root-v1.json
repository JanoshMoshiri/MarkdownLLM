{
  "description": "MarkdownLLM project lifecycle hardening",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"\nMDLLM=\"$ROOT/\"'./tools/mdllm.py'\nFW=\"${MDLLM%/*/*}\"\nPY=\"\"\nfor c in \"$ROOT/.venv/bin/python\" \"$ROOT/.venv/Scripts/python.exe\" \\\n         \"$FW/.venv/bin/python\" \"$FW/.venv/Scripts/python.exe\" \\\n         python3 python py; do\n  if \"$c\" -c \"import yaml\" >/dev/null 2>&1; then PY=\"$c\"; break; fi\ndone\nif [ -z \"$PY\" ] || [ ! -f \"$MDLLM\" ]; then\n  printf '%s\\n' '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"MarkdownLLM session-start could not run: no floor-capable Python or mdllm.py was found.\"}}'\nelse\n  \"$PY\" \"$MDLLM\" harness-event codex session-start \"$ROOT\" 'sha256:627e0ec8021eeb79c61cfbf905ccd9393c364682ff5f005c2f85f1c7a3b5c0f5'\nfi\nexit 0",
            "commandWindows": "cmd.exe /d /v:on /s /c \"set _MDLLM_&where.exe pwsh.exe >nul 2>nul&if errorlevel 1 (powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand !_MDLLM_HOOK!) else (pwsh.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand !_MDLLM_HOOK!)&exit /b 0\"",
            "timeout": 120,
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\"\nMDLLM=\"$ROOT/\"'./tools/mdllm.py'\nFW=\"${MDLLM%/*/*}\"\nPY=\"\"\nfor c in \"$ROOT/.venv/bin/python\" \"$ROOT/.venv/Scripts/python.exe\" \\\n         \"$FW/.venv/bin/python\" \"$FW/.venv/Scripts/python.exe\" \\\n         python3 python py; do\n  if \"$c\" -c \"import yaml\" >/dev/null 2>&1; then PY=\"$c\"; break; fi\ndone\nif [ -z \"$PY\" ] || [ ! -f \"$MDLLM\" ]; then\n  printf '%s\\n' '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"MarkdownLLM post-write could not run: no floor-capable Python or mdllm.py was found.\"}}'\nelse\n  \"$PY\" \"$MDLLM\" harness-event codex post-write \"$ROOT\" 'sha256:f5aaf1c255f020b8681ea8ee0faabf0397a378989e4679d4d59ae536e2affdbc'\nfi\nexit 0",
            "commandWindows": "cmd.exe /d /v:on /s /c \"set _MDLLM_&where.exe pwsh.exe >nul 2>nul&if errorlevel 1 (powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand !_MDLLM_HOOK!) else (pwsh.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand !_MDLLM_HOOK!)&exit /b 0\"",
            "timeout": 120,
            "additionalContextLimit": 2500
          }
        ]
      }
    ]
  }
}
