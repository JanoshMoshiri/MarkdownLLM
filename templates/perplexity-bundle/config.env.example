# markdownllm-bootstrap configuration
#
# Flat KEY=VALUE lines — parsed by both bootstrap.sh and `mdllm assemble`;
# deliberately not sourced as bash (no arrays, no code execution).
# `mdllm bundle --harness perplexity` derives the real config.env from your
# local estate; this example exists for hand-building one elsewhere.
#
# Credentials are ambient: run `gh auth setup-git` (with the connected GitHub
# credential) before the bootstrap. No PAT field — and never set GH_PAT for
# this adapter; an unset GH_PAT is what selects the ambient-credential path.

# Framework repository, as a GitHub owner/repo pair.
FRAMEWORK_REPO=OWNER/MarkdownLLM
# Full commit selected when the bundle is built. Bootstrap fetches this exact
# tree; a moving default branch is not executable authority.
FRAMEWORK_COMMIT=0123456789abcdef0123456789abcdef01234567

# Commit identity applied to every domain this session.
GIT_NAME=Your Name
GIT_EMAIL=you@example.com

# Domains to load — whitespace-separated owner/repo entries (or URLs), one line.
DOMAINS=OWNER/domain-a OWNER/domain-b

# Optional — friendly surface only. Set these in the private rendered
# config.env (this file is a public template; real names belong in the
# gitignored bundle output, not in framework source).
# The operator's first name, to personalise the friendly greeting.
FRIENDLY_PROFILE_NAME=
# Restrict the friendly skill to a subset of domains.
FRIENDLY_DOMAINS=
