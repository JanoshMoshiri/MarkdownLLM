# Normative domain schema — read by tools/mdllm.py (the deterministic floor).
# Place at <domain>/things/_schema.yaml (or domain root). Declares the thing
# types, status vocabularies, and relation vocabulary this domain permits;
# `mdllm validate` enforces exactly what is declared here.
#
# Framework-reserved types (insight, conflict, retrospective, continuity-brief,
# decision, index, specification, guide, manifesto, skill, prompt) are built
# into the tool — do NOT redeclare them.
schema_version: 1
domain: [domain-name]

options:
  # The scaffolded skills use the framework's dotted naming convention
  # (x-read.thing.skill.md) with plain kebab-case ids, so the id↔filename
  # check is off. Flip to true if your domain's files all match their ids.
  id_filename_match: false

# Declare one entry per thing type. The placeholders below are commented out
# so this file is valid YAML from the moment it is copied — uncomment and
# rename as your types emerge. (An unparseable schema breaks `mdllm validate`.)
types: {}
#  your-thing-type:
#    statuses: [not-started, in-progress, completed] # the FULL lifecycle this type moves through
#    # required_fields: [field-a, field-b]           # enforced as Error when missing
#  another-type:
#    statuses: [open, figures-ready, submitted]

# Relation vocabulary (validated at Warning severity). Start small — grow it
# when a real link needs a relation that isn't here, prune at retrospectives.
# The first four are what the scaffolded skills already use.
relations:
  - informs
  - implements
  - complements
  - orchestrates   # workflow skill sequencing other skills
  - references
  - related
  - supersedes
  - superseded-by
  - contradicts
