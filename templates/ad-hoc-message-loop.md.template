# concludes the conversation in committed state; ordinary closure is not
# that declaration.
stages:
  - id: [actor-a]
    to: [[actor-b], closed]
    actor: [actor-a]
  - id: [actor-b]
    to: [[actor-a], closed]
    actor: [actor-b]
  - id: closed
    to: [[actor-a], [actor-b]]
