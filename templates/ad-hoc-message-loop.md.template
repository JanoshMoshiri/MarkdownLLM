# The ticket's turn graph. Each stage id IS an actor name, because a
# ticket's `status` is its addressee; `actor` on each stage names the role
# `mdllm watch --role <actor>` wakes there. Add a stage per actor that may
# be addressed. `closed` wakes nobody and means nothing is owed right now;
# a reopen is a declared move back to an actor, because the conversation's
# end is its work item's end, not the ticket's.
stages:
  - id: [actor-a]
    to: [[actor-b], closed]
    actor: [actor-a]
  - id: [actor-b]
    to: [[actor-a], closed]
    actor: [actor-b]
  - id: closed
    to: [[actor-a], [actor-b]]
